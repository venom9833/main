{
  "id": "guide",
  "mode": "skeleton",
  "label": "가이드 문서",
  "description": "자동 목차·스크롤마커 가이드 (ContentsMarker)",
  "skeleton_file": "skeleton.html",
  "styles_file": "styles.css",
  "shared_cm_file": "contents-marker-base.css",
  "palette": {
    "background": "#ffffff",
    "surface": "#f9fafb",
    "text_primary": "#0f172a",
    "text_secondary": "#64748b",
    "divider": "#e2e8f0",
    "accent": "#b45309"
  },
  "content_schema": {
    "type": "object",
    "required": ["title", "sections"],
    "properties": {
      "title":    { "type": "string", "description": "문서 제목" },
      "subtitle": { "type": "string", "description": "부제목 (선택)" },
      "author":   { "type": "string", "description": "작성자 이름 (선택)" },
      "date":     { "type": "string", "description": "작성일 (예: 2025년 4월)" },
      "intro":    { "type": "string", "description": "문서 도입부 2~3문장" },
      "sections": {
        "type": "array",
        "minItems": 4,
        "maxItems": 8,
        "description": "본문 섹션 목록",
        "items": {
          "type": "object",
          "required": ["id", "heading", "paragraphs"],
          "properties": {
            "id":         { "type": "string", "description": "영문 소문자 하이픈 앵커 ID (예: overview)" },
            "heading":    { "type": "string", "description": "섹션 제목 (h2)" },
            "paragraphs": { "type": "array", "items": { "type": "string" }, "minItems": 2, "description": "본문 단락 2개 이상" },
            "subsections": {
              "type": "array",
              "description": "하위 섹션 (h3, 선택)",
              "items": {
                "type": "object",
                "required": ["id", "heading", "paragraphs"],
                "properties": {
                  "id":         { "type": "string" },
                  "heading":    { "type": "string" },
                  "paragraphs": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
                }
              }
            }
          }
        }
      },
      "conclusion": { "type": "string", "description": "마무리 단락 (선택)" }
    }
  }
}
