{
  "id": "landing",
  "mode": "skeleton",
  "label": "랜딩페이지",
  "description": "자동 목차·스크롤마커 랜딩페이지 (ContentsMarker)",
  "skeleton_file": "skeleton.html",
  "styles_file": "styles.css",
  "shared_cm_file": "contents-marker-base.css",
  "palette": {
    "background": "#ffffff",
    "surface": "#f8fafc",
    "surface_alt": "#eef2ff",
    "text_primary": "#0f172a",
    "text_secondary": "#475569",
    "divider": "#e2e8f0",
    "accent": "#4f46e5",
    "accent_dark": "#3730a3"
  },
  "content_schema": {
    "type": "object",
    "required": ["hero", "features_heading", "features", "steps_heading", "steps", "testimonials_heading", "testimonials", "pricing_heading", "pricing", "faq_heading", "faq", "cta_heading", "cta_body", "cta_label"],
    "properties": {
      "hero": {
        "type": "object",
        "required": ["eyebrow", "headline", "tagline", "cta_label"],
        "description": "히어로 섹션 콘텐츠",
        "properties": {
          "eyebrow":   { "type": "string", "description": "상단 작은 레이블 (짧게, 영문/한글)" },
          "headline":  { "type": "string", "description": "메인 헤드라인 (임팩트 있게, 30자 내외)" },
          "tagline":   { "type": "string", "description": "헤드라인 보완 문장 (2~3문장)" },
          "cta_label": { "type": "string", "description": "버튼 텍스트" },
          "sub_text":  { "type": "string", "description": "버튼 아래 보조 문구 (선택)" }
        }
      },
      "features_heading": { "type": "string", "description": "핵심 기능 섹션 제목" },
      "features": {
        "type": "array",
        "minItems": 3,
        "maxItems": 6,
        "description": "핵심 기능 목록",
        "items": {
          "type": "object",
          "required": ["icon", "title", "desc"],
          "properties": {
            "icon":  { "type": "string", "description": "이모지 아이콘 (1자)" },
            "title": { "type": "string", "description": "기능 제목" },
            "desc":  { "type": "string", "description": "기능 설명 2~3문장" }
          }
        }
      },
      "steps_heading": { "type": "string", "description": "이용 방법 섹션 제목" },
      "steps": {
        "type": "array",
        "minItems": 3,
        "maxItems": 5,
        "description": "이용 단계 목록",
        "items": {
          "type": "object",
          "required": ["title", "desc"],
          "properties": {
            "title": { "type": "string", "description": "단계 제목" },
            "desc":  { "type": "string", "description": "단계 설명" }
          }
        }
      },
      "testimonials_heading": { "type": "string", "description": "후기 섹션 제목" },
      "testimonials": {
        "type": "array",
        "minItems": 2,
        "maxItems": 3,
        "description": "사용자 후기 목록",
        "items": {
          "type": "object",
          "required": ["quote", "name"],
          "properties": {
            "quote": { "type": "string", "description": "후기 내용 (2~4문장)" },
            "name":  { "type": "string", "description": "이름" },
            "role":  { "type": "string", "description": "직함 또는 역할 (선택)" }
          }
        }
      },
      "pricing_heading": { "type": "string", "description": "가격 섹션 제목" },
      "pricing": {
        "type": "object",
        "required": ["label", "price", "period", "features"],
        "description": "가격 플랜 (단일 플랜)",
        "properties": {
          "label":     { "type": "string", "description": "플랜 이름" },
          "price":     { "type": "string", "description": "가격 (예: ₩49,000)" },
          "period":    { "type": "string", "description": "과금 단위 (예: /월, /건)" },
          "highlight": { "type": "string", "description": "강조 문구 (예: 지금 시작하면 30% 할인)" },
          "features":  { "type": "array", "items": { "type": "string" }, "minItems": 4, "description": "포함 기능 목록" },
          "note":      { "type": "string", "description": "하단 안내 (선택, 예: 언제든 해지 가능)" }
        }
      },
      "faq_heading": { "type": "string", "description": "FAQ 섹션 제목" },
      "faq": {
        "type": "array",
        "minItems": 3,
        "maxItems": 5,
        "description": "자주 묻는 질문 목록",
        "items": {
          "type": "object",
          "required": ["id", "question", "answer"],
          "properties": {
            "id":       { "type": "string", "description": "영문 소문자 하이픈 앵커 ID" },
            "question": { "type": "string", "description": "질문" },
            "answer":   { "type": "string", "description": "답변 2~3문장" }
          }
        }
      },
      "cta_heading": { "type": "string", "description": "마지막 CTA 제목" },
      "cta_body":    { "type": "string", "description": "마지막 CTA 본문" },
      "cta_label":   { "type": "string", "description": "마지막 CTA 버튼 텍스트" }
    }
  }
}
