{
  "id": "landing/video-bg",
  "mode": "skeleton",
  "label": "풀스크린 비디오 랜딩페이지",
  "description": "CSS scroll-snap 기반 풀스크린 섹션 스택. 각 섹션에 비디오 배경(또는 그라디언트 폴백) + 제목 + CTA. 영상 스튜디오·프로덕션·크리에이티브 에이전시에 적합.",
  "skeleton_file": "skeleton.html",
  "styles_file": "styles.css",
  "palette": {
    "background": "#0a0a0a",
    "text_primary": "#ffffff",
    "text_muted": "rgba(255,255,255,0.65)",
    "accent": "#ffffff",
    "overlay": "rgba(0,0,0,0.45)"
  },
  "content_schema": {
    "type": "object",
    "required": ["brand", "sections"],
    "properties": {
      "brand": {"type": "string"},
      "nav_links": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "label": {"type": "string"},
            "href": {"type": "string"}
          }
        }
      },
      "header_cta": {"type": "string"},
      "sections": {
        "type": "array",
        "minItems": 2,
        "maxItems": 8,
        "items": {
          "type": "object",
          "required": ["headline", "cta_primary", "bg_gradient"],
          "properties": {
            "type": {"type": "string", "enum": ["hero", "project", "final_cta"], "description": "섹션 타입"},
            "headline": {"type": "string", "description": "메인 제목"},
            "body": {"type": "string", "description": "부제 텍스트 (선택)"},
            "cta_primary": {"type": "string"},
            "cta_secondary": {"type": "string", "description": "두 번째 CTA (선택)"},
            "tag": {"type": "string", "description": "상단 작은 레이블 (선택)"},
            "bg_gradient": {"type": "string", "description": "CSS gradient — 비디오 없을 때 배경"},
            "video_url": {"type": "string", "description": "MP4 비디오 URL (선택, 비어있으면 그라디언트 사용)"}
          }
        }
      }
    }
  }
}
