{
  "id": "landing/video-studio",
  "mode": "skeleton",
  "label": "영상 스튜디오 랜딩페이지",
  "description": "CSS scroll-snap 기반 풀스크린 섹션 스택. 각 섹션에 비디오 배경(또는 그라디언트 폴백) + 헤드라인 + CTA 버튼. GSAP ScrollTrigger + Lenis 스무스 스크롤. 영상 스튜디오·프로덕션·크리에이티브 에이전시에 적합.",
  "skeleton_file": "skeleton.html",
  "styles_file": "styles.css",
  "palette": {
    "background": "#0a0a0a",
    "text_primary": "#ffffff",
    "text_muted": "rgba(255,255,255,0.65)",
    "overlay": "rgba(0,0,0,0.5)"
  },
  "content_schema": {
    "type": "object",
    "required": ["brand", "nav_links", "header_cta", "sections"],
    "properties": {
      "brand": {"type": "string", "description": "스튜디오/브랜드명"},
      "nav_links": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["label", "href"],
          "properties": {
            "label": {"type": "string"},
            "href": {"type": "string"}
          }
        }
      },
      "header_cta": {"type": "string", "description": "헤더 CTA 버튼 텍스트"},
      "sections": {
        "type": "array",
        "minItems": 3,
        "maxItems": 8,
        "items": {
          "type": "object",
          "required": ["headline", "cta_primary"],
          "properties": {
            "type": {"type": "string", "enum": ["hero", "project", "final_cta"]},
            "tag": {"type": "string", "description": "상단 소형 레이블 (선택)"},
            "headline": {"type": "string"},
            "body": {"type": "string", "description": "서브 텍스트 (선택)"},
            "cta_primary": {"type": "string"},
            "cta_secondary": {"type": "string", "description": "두 번째 CTA (선택)"},
            "video_url": {"type": "string", "description": "MP4 또는 HLS(.m3u8) URL (비어있으면 그라디언트 배경)"},
            "poster_url": {"type": "string", "description": "동영상 로딩 전 표시할 썸네일 이미지 URL (선택)"},
            "bg_gradient": {"type": "string", "description": "CSS gradient — 비디오 없을 때 배경"}
          }
        }
      }
    }
  }
}
