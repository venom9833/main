{
  "id": "neuromorphic",
  "mode": "skeleton",
  "label": "개발자 프로필",
  "description": "다크 그림자·시스템 인터페이스 미학의 개발자·AI 엔지니어 전용 프로필 페이지",
  "skeleton_file": "skeleton.html",
  "styles_file": "styles.css",
  "palette": {
    "bg":           "#0f1117",
    "surface":      "#1a1d27",
    "surface_alt":  "#21253300",
    "border":       "#2e3244",
    "text_primary": "#e2e8f0",
    "text_muted":   "#64748b",
    "accent_cyan":  "#22d3ee",
    "accent_violet":"#a78bfa",
    "status_green": "#4ade80",
    "status_amber": "#fbbf24"
  },
  "content_schema": {
    "type": "object",
    "required": ["identity", "metrics_heading", "metrics", "modules_heading", "modules", "projects_heading", "projects", "connect_heading", "connect_items"],
    "properties": {
      "identity": {
        "type": "object",
        "required": ["handle", "name", "role", "tagline"],
        "description": "개발자 신원 정보",
        "properties": {
          "handle":    { "type": "string", "description": "핸들명 (예: @dev_username)" },
          "name":      { "type": "string", "description": "실명" },
          "role":      { "type": "string", "description": "역할 (예: AI Engineer / Full Stack)" },
          "tagline":   { "type": "string", "description": "한 줄 표어 (25자 내외)" },
          "system_id": { "type": "string", "description": "고유 시스템 ID (예: SYS-2025-001) — 장식용" },
          "status":    { "type": "string", "description": "현재 상태 (ONLINE | BUILDING | FOCUS)" },
          "location":  { "type": "string", "description": "위치 (선택)" }
        }
      },
      "metrics_heading": { "type": "string", "description": "지표 섹션 레이블 (예: SYSTEM METRICS)" },
      "metrics": {
        "type": "array",
        "minItems": 3,
        "maxItems": 4,
        "description": "핵심 수치 지표",
        "items": {
          "type": "object",
          "required": ["label", "value"],
          "properties": {
            "label": { "type": "string", "description": "지표명 (예: 경력, 프로젝트, 기술)" },
            "value": { "type": "string", "description": "수치 (예: 7Y, 42, 18+)" },
            "unit":  { "type": "string", "description": "단위 설명 (선택, 예: years active)" }
          }
        }
      },
      "modules_heading": { "type": "string", "description": "기술 스택 섹션 레이블 (예: LOADED MODULES)" },
      "modules": {
        "type": "array",
        "minItems": 3,
        "maxItems": 5,
        "description": "기술 카테고리별 모듈 목록",
        "items": {
          "type": "object",
          "required": ["category", "items"],
          "properties": {
            "category": { "type": "string", "description": "카테고리명 (예: AI/ML, Frontend, Infra)" },
            "items":    { "type": "array", "items": { "type": "string" }, "minItems": 3, "maxItems": 6 }
          }
        }
      },
      "projects_heading": { "type": "string", "description": "프로젝트 섹션 레이블 (예: ACTIVE PROCESSES)" },
      "projects": {
        "type": "array",
        "minItems": 2,
        "maxItems": 4,
        "description": "주요 프로젝트 목록",
        "items": {
          "type": "object",
          "required": ["name", "desc", "tags"],
          "properties": {
            "name":   { "type": "string", "description": "프로젝트명" },
            "status": { "type": "string", "description": "상태 (ACTIVE | DEPLOYED | ARCHIVED)" },
            "desc":   { "type": "string", "description": "프로젝트 설명 2~3문장" },
            "tags":   { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 5 },
            "metric": { "type": "string", "description": "성과 지표 (선택, 예: 1.2K users, ★ 890)" },
            "url":    { "type": "string", "description": "링크 (선택)" }
          }
        }
      },
      "connect_heading": { "type": "string", "description": "연락처 섹션 레이블 (예: NETWORK INTERFACES)" },
      "connect_items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 4,
        "description": "연결 채널 목록",
        "items": {
          "type": "object",
          "required": ["protocol", "icon", "value"],
          "properties": {
            "protocol": { "type": "string", "description": "프로토콜 레이블 (예: EMAIL, GITHUB, LINKEDIN, API)" },
            "icon":     { "type": "string", "description": "이모지 아이콘" },
            "value":    { "type": "string", "description": "연결 주소 또는 ID" },
            "url":      { "type": "string", "description": "링크 URL (선택)" }
          }
        }
      }
    }
  }
}
