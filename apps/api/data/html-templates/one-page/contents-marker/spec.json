{
  "id": "one-page",
  "mode": "skeleton",
  "label": "원페이지 프로필",
  "description": "자동 목차·스크롤마커 개인 프로필 원페이지 (ContentsMarker)",
  "skeleton_file": "skeleton.html",
  "styles_file": "styles.css",
  "shared_cm_file": "contents-marker-base.css",
  "palette": {
    "background": "#ffffff",
    "surface": "#fafafa",
    "surface_alt": "#f5f3ff",
    "text_primary": "#1e1b4b",
    "text_secondary": "#6b7280",
    "divider": "#e5e7eb",
    "accent": "#7c3aed",
    "accent_dark": "#6d28d9"
  },
  "content_schema": {
    "type": "object",
    "required": ["person", "about_heading", "about", "skills_heading", "skill_groups", "experience_heading", "experiences", "projects_heading", "projects", "contact_heading", "contact_items"],
    "properties": {
      "person": {
        "type": "object",
        "required": ["name", "title", "avatar_emoji", "tagline"],
        "description": "기본 인물 정보",
        "properties": {
          "name":         { "type": "string", "description": "이름 (실명 또는 닉네임)" },
          "title":        { "type": "string", "description": "직함 또는 역할 (예: 풀스택 개발자, UX 디자이너)" },
          "avatar_emoji": { "type": "string", "description": "프로필 이모지 (1자)" },
          "tagline":      { "type": "string", "description": "한 줄 자기소개" },
          "location":     { "type": "string", "description": "거주 지역 (선택, 예: 서울, Seoul)" }
        }
      },
      "about_heading": { "type": "string", "description": "소개 섹션 제목" },
      "about": {
        "type": "array",
        "minItems": 2,
        "maxItems": 3,
        "description": "자기소개 단락 2~3개",
        "items": { "type": "string" }
      },
      "skills_heading": { "type": "string", "description": "기술 섹션 제목" },
      "skill_groups": {
        "type": "array",
        "minItems": 2,
        "maxItems": 4,
        "description": "기술 그룹 목록",
        "items": {
          "type": "object",
          "required": ["group", "skills"],
          "properties": {
            "group":  { "type": "string", "description": "그룹 이름 (예: 프론트엔드, 언어, 도구)" },
            "skills": {
              "type": "array",
              "minItems": 3,
              "items": { "type": "string", "description": "기술 이름" }
            }
          }
        }
      },
      "experience_heading": { "type": "string", "description": "경력 섹션 제목" },
      "experiences": {
        "type": "array",
        "minItems": 2,
        "maxItems": 4,
        "description": "경력 목록",
        "items": {
          "type": "object",
          "required": ["id", "role", "company", "period", "bullets"],
          "properties": {
            "id":      { "type": "string", "description": "영문 소문자 하이픈 ID" },
            "role":    { "type": "string", "description": "직책명" },
            "company": { "type": "string", "description": "회사명" },
            "period":  { "type": "string", "description": "재직 기간 (예: 2022.03 — 현재)" },
            "bullets": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "description": "주요 업무 2~4개",
              "items": { "type": "string" }
            }
          }
        }
      },
      "projects_heading": { "type": "string", "description": "프로젝트 섹션 제목" },
      "projects": {
        "type": "array",
        "minItems": 2,
        "maxItems": 4,
        "description": "주요 프로젝트 목록",
        "items": {
          "type": "object",
          "required": ["id", "title", "desc", "tags"],
          "properties": {
            "id":    { "type": "string", "description": "영문 소문자 하이픈 ID" },
            "title": { "type": "string", "description": "프로젝트 이름" },
            "desc":  { "type": "string", "description": "프로젝트 설명 2~3문장" },
            "tags":  { "type": "array", "items": { "type": "string" }, "minItems": 2, "description": "사용 기술 태그" },
            "url":   { "type": "string", "description": "링크 URL (선택)" }
          }
        }
      },
      "contact_heading": { "type": "string", "description": "연락처 섹션 제목" },
      "contact_items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 5,
        "description": "연락처 항목",
        "items": {
          "type": "object",
          "required": ["icon", "label", "value"],
          "properties": {
            "icon":  { "type": "string", "description": "이모지 아이콘" },
            "label": { "type": "string", "description": "항목 이름 (예: 이메일, GitHub)" },
            "value": { "type": "string", "description": "값 또는 주소" },
            "url":   { "type": "string", "description": "링크 URL (선택)" }
          }
        }
      }
    }
  }
}
