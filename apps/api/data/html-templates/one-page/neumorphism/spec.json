{
  "id": "one-page",
  "mode": "skeleton",
  "label": "원페이지 프로필",
  "description": "소프트 그림자로 입체감을 주는 뉴모피즘 개인 프로필 원페이지",
  "skeleton_file": "skeleton.html",
  "styles_file": "styles.css",
  "palette": {
    "bg":           "#e0e5ec",
    "shadow_dark":  "#b8bec7",
    "shadow_light": "#ffffff",
    "text_primary": "#31344b",
    "text_secondary":"#6b7280",
    "accent":       "#6d5bba",
    "accent_light": "#ede9fe"
  },
  "content_schema": {
    "type": "object",
    "required": ["person", "about_heading", "about", "skills_heading", "skill_groups", "experience_heading", "experiences", "projects_heading", "projects", "contact_heading", "contact_items"],
    "properties": {
      "person": {
        "type": "object",
        "required": ["name", "title", "avatar_emoji", "tagline"],
        "description": "기본 인물 정보",
        "properties": {
          "name":         { "type": "string", "description": "이름" },
          "title":        { "type": "string", "description": "직함 (예: UX 디자이너, 풀스택 개발자)" },
          "avatar_emoji": { "type": "string", "description": "프로필 이모지 (1자)" },
          "tagline":      { "type": "string", "description": "한 줄 자기소개 (25자 내외)" },
          "location":     { "type": "string", "description": "거주 지역 (선택)" }
        }
      },
      "about_heading": { "type": "string", "description": "소개 섹션 제목" },
      "about": {
        "type": "array",
        "minItems": 2,
        "maxItems": 3,
        "description": "자기소개 단락 2~3개",
        "items": { "type": "string" }
      },
      "skills_heading": { "type": "string", "description": "기술 섹션 제목" },
      "skill_groups": {
        "type": "array",
        "minItems": 2,
        "maxItems": 4,
        "description": "기술 그룹 목록",
        "items": {
          "type": "object",
          "required": ["group", "skills"],
          "properties": {
            "group":  { "type": "string", "description": "그룹명 (예: 프론트엔드, 디자인, 도구)" },
            "skills": {
              "type": "array",
              "minItems": 3,
              "maxItems": 6,
              "items": { "type": "string" }
            }
          }
        }
      },
      "experience_heading": { "type": "string", "description": "경력 섹션 제목" },
      "experiences": {
        "type": "array",
        "minItems": 2,
        "maxItems": 3,
        "description": "경력 목록",
        "items": {
          "type": "object",
          "required": ["role", "company", "period", "bullets"],
          "properties": {
            "role":    { "type": "string", "description": "직책" },
            "company": { "type": "string", "description": "회사명" },
            "period":  { "type": "string", "description": "재직 기간 (예: 2022.03 — 현재)" },
            "bullets": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": { "type": "string", "description": "주요 업무" }
            }
          }
        }
      },
      "projects_heading": { "type": "string", "description": "프로젝트 섹션 제목" },
      "projects": {
        "type": "array",
        "minItems": 2,
        "maxItems": 3,
        "description": "주요 프로젝트",
        "items": {
          "type": "object",
          "required": ["title", "desc", "tags"],
          "properties": {
            "title": { "type": "string", "description": "프로젝트명" },
            "desc":  { "type": "string", "description": "프로젝트 설명 2~3문장" },
            "tags":  { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 5 },
            "url":   { "type": "string", "description": "링크 URL (선택)" }
          }
        }
      },
      "contact_heading": { "type": "string", "description": "연락처 섹션 제목" },
      "contact_items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 4,
        "description": "연락처 항목",
        "items": {
          "type": "object",
          "required": ["icon", "label", "value"],
          "properties": {
            "icon":  { "type": "string" },
            "label": { "type": "string" },
            "value": { "type": "string" },
            "url":   { "type": "string" }
          }
        }
      },
      "footer_text": { "type": "string", "description": "푸터 한 줄 (선택, 예: © 2025 이름 · 서울)" }
    }
  }
}
