{
  "id": "portfolio",
  "label": "포트폴리오",
  "version": "1.0.0",
  "description": "작업물을 갤러리 그리드로 보여주는 포트폴리오. 프로필·기술스택·프로젝트 카드·연락처 구조.",

  "layout": {
    "type": "single-column",
    "maxWidth": "1100px",
    "margin": "0 auto",
    "padding": "0 2rem",
    "sidebar": false
  },

  "sections": {
    "order": ["nav", "hero_profile", "about", "skills", "projects_gallery", "experience_optional", "contact", "footer"]
  },

  "palette": {
    "background":        "#0f172a",
    "surface":           "#1e293b",
    "surface_hover":     "#253347",
    "text_primary":      "#f1f5f9",
    "text_secondary":    "#94a3b8",
    "accent":            "#db2777",
    "accent_light":      "#fdf2f8",
    "accent_gradient":   "linear-gradient(135deg, #ec4899, #db2777)",
    "skill_tag_bg":      "#1e293b",
    "skill_tag_border":  "#334155",
    "skill_tag_text":    "#94a3b8",
    "card_bg":           "#1e293b",
    "card_border":       "#334155",
    "card_hover_border": "#db2777",
    "image_placeholder": "#253347",
    "divider":           "#334155"
  },

  "typography": {
    "font_primary": "'Pretendard', -apple-system, sans-serif",
    "base_size":    "1rem",
    "line_height":  1.7
  },

  "blocks": {
    "nav": {
      "style": "fixed top, minimal",
      "elements": ["brand_name_or_logo", "nav_links"],
      "background": "rgba(15,23,42,0.92)",
      "backdrop_filter": "blur(12px)",
      "height": "60px",
      "nav_links": ["작업물", "소개", "기술", "연락처"]
    },
    "hero_profile": {
      "layout": "centered 또는 left+right split",
      "elements": ["avatar_circle_large", "name_h1", "role_subtitle", "tagline", "cta_buttons", "social_links"],
      "avatar": {
        "size": "120px",
        "border": "3px solid accent",
        "shape": "circle",
        "placeholder_bg": "surface"
      },
      "name": { "size": "clamp(2rem, 5vw, 3.5rem)", "weight": 800 },
      "role": { "size": "1.2rem", "color": "accent", "weight": 600 },
      "tagline": { "size": "1rem", "color": "text_secondary" },
      "cta_buttons": {
        "primary": { "label": "작업물 보기", "background": "accent_gradient", "color": "#ffffff" },
        "secondary": { "label": "연락하기", "background": "transparent", "border": "1px solid accent", "color": "accent" }
      },
      "padding": "8rem 2rem"
    },
    "about": {
      "background": "surface",
      "padding": "4rem",
      "border_radius": "20px",
      "elements": ["section_title", "bio_paragraphs", "highlight_stats"],
      "highlight_stats": {
        "layout": "3-column",
        "item": { "number": "강조 수치", "label": "설명" }
      }
    },
    "skill_section": {
      "categories": ["Frontend", "Backend", "Design", "Tools"],
      "tag": {
        "style": "pill",
        "background": "skill_tag_bg",
        "border": "1px solid skill_tag_border",
        "color": "skill_tag_text",
        "padding": "0.4rem 1rem",
        "border_radius": "999px",
        "hover_border": "accent"
      }
    },
    "project_gallery": {
      "layout": "masonry 또는 2~3 column grid",
      "card": {
        "background": "card_bg",
        "border": "1px solid card_border",
        "border_radius": "16px",
        "overflow": "hidden",
        "hover": "border-color: card_hover_border + box-shadow",
        "elements": ["image_placeholder", "tag_category", "title", "description_2lines", "tech_stack_tags", "links"]
      },
      "image_placeholder": {
        "height": "200px",
        "background": "image_placeholder",
        "display": "flex align-items-center justify-content-center"
      },
      "card_padding": "1.5rem",
      "links": {
        "github": { "icon": "GitHub", "style": "text link" },
        "live":   { "icon": "↗", "style": "accent color" }
      }
    },
    "contact": {
      "background": "surface",
      "border_radius": "20px",
      "padding": "4rem",
      "elements": ["section_title", "subtitle", "contact_items", "social_links"],
      "contact_items": ["email", "location_optional", "availability_badge"],
      "availability_badge": {
        "label": "협업 가능 / 구직 중",
        "background": "rgba(34,197,94,0.1)",
        "color": "#22c55e",
        "border": "1px solid rgba(34,197,94,0.3)",
        "border_radius": "999px"
      }
    },
    "footer": {
      "elements": ["name", "copyright", "back_to_top_link"],
      "text_align": "center",
      "color": "text_secondary",
      "padding": "2rem"
    }
  },

  "project_card_rules": [
    "프로젝트 카드 클릭 시 상세 페이지 또는 외부 링크로 이동",
    "이미지 placeholder는 프로젝트 대표 색상으로 배경 설정",
    "기술 스택 태그는 카드당 최대 4개",
    "설명은 2줄 말줄임(ellipsis) 처리"
  ],

  "inline_emphasis": {
    "bold":         "프로젝트명, 역할명",
    "accent_color": "핵심 기술, 링크",
    "tag":          "기술 스택 pill 태그"
  },

  "tone": {
    "voice": "1인칭 자기 소개 — '저는', '제가 만든', '담당했습니다'",
    "description": "동사 중심 압축 — '설계했습니다', '개선했습니다', '구현했습니다'",
    "number_emphasis": "성과 수치 적극 활용 — '응답속도 40% 개선', '사용자 1만 명'"
  },

  "chapter_internal_flow": [
    "네비게이션 (고정)",
    "히어로 프로필 (이름·역할·CTA)",
    "소개 (bio + 하이라이트 수치)",
    "기술 스택 (카테고리별 태그)",
    "프로젝트 갤러리 (카드 그리드)",
    "경력 (선택)",
    "연락처",
    "푸터"
  ]
}
