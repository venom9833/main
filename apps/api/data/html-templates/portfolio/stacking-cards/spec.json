{
  "id": "portfolio",
  "mode": "skeleton",
  "label": "포트폴리오",
  "description": "6장 카드가 순차 적층되는 풀스크린 개인 포트폴리오 (StackingCards)",
  "skeleton_file": "skeleton.html",
  "styles_file": "styles.css",
  "shared_sc_file": "stacking-cards-base.css",
  "palette": {
    "background": "#1e1033",
    "accent": "#a78bfa",
    "accent_dark": "#7c3aed",
    "text_on_dark": "#f5f3ff",
    "text_on_light": "#1e1b4b",
    "text_muted_dark": "#c4b5fd",
    "text_muted_light": "#6b7280"
  },
  "content_schema": {
    "type": "object",
    "required": ["profile", "facts", "work_heading", "projects", "skills_heading", "skill_groups", "process_heading", "process", "testimonials_heading", "testimonials", "contact_heading", "contact_body", "contact_label"],
    "properties": {
      "profile": {
        "type": "object",
        "required": ["avatar_emoji", "name", "role", "tagline"],
        "description": "1번 카드 — 자기소개",
        "properties": {
          "avatar_emoji": { "type": "string", "description": "프로필 이모지 (1자)" },
          "name":         { "type": "string", "description": "이름" },
          "role":         { "type": "string", "description": "직함 (예: UX 디자이너, 풀스택 개발자)" },
          "tagline":      { "type": "string", "description": "한 줄 자기소개 (20자 내외)" },
          "location":     { "type": "string", "description": "활동 지역 (선택)" }
        }
      },
      "facts": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "description": "핵심 수치·사실 3개 (경력, 프로젝트 수 등)",
        "items": {
          "type": "object",
          "required": ["value", "label"],
          "properties": {
            "value": { "type": "string", "description": "수치 또는 키워드 (예: 7년, 50+, 풀스택)" },
            "label": { "type": "string", "description": "설명 레이블 (짧게)" }
          }
        }
      },
      "work_heading": { "type": "string", "description": "2번 카드 섹션 레이블 (6자 이하 대문자)" },
      "projects": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "description": "대표 프로젝트 3개",
        "items": {
          "type": "object",
          "required": ["title", "category", "desc", "tags"],
          "properties": {
            "title":    { "type": "string", "description": "프로젝트 이름" },
            "category": { "type": "string", "description": "프로젝트 카테고리 (예: 웹앱, 브랜딩, API)" },
            "desc":     { "type": "string", "description": "프로젝트 설명 (2문장)" },
            "tags":     { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 3 },
            "result":   { "type": "string", "description": "성과 또는 결과 (선택, 짧게)" }
          }
        }
      },
      "skills_heading": { "type": "string", "description": "3번 카드 섹션 레이블" },
      "skill_groups": {
        "type": "array",
        "minItems": 3,
        "maxItems": 4,
        "description": "기술 그룹",
        "items": {
          "type": "object",
          "required": ["group", "items"],
          "properties": {
            "group": { "type": "string", "description": "그룹 이름" },
            "items": { "type": "array", "minItems": 3, "maxItems": 6, "items": { "type": "string" } }
          }
        }
      },
      "process_heading": { "type": "string", "description": "4번 카드 섹션 레이블" },
      "process": {
        "type": "array",
        "minItems": 3,
        "maxItems": 4,
        "description": "작업 프로세스 단계",
        "items": {
          "type": "object",
          "required": ["icon", "title", "desc"],
          "properties": {
            "icon":  { "type": "string", "description": "이모지" },
            "title": { "type": "string", "description": "단계 이름" },
            "desc":  { "type": "string", "description": "단계 설명 (1~2문장)" }
          }
        }
      },
      "testimonials_heading": { "type": "string", "description": "5번 카드 섹션 레이블" },
      "testimonials": {
        "type": "array",
        "minItems": 2,
        "maxItems": 3,
        "description": "클라이언트 후기",
        "items": {
          "type": "object",
          "required": ["quote", "name", "role"],
          "properties": {
            "quote": { "type": "string", "description": "후기 내용 (2~3문장)" },
            "name":  { "type": "string", "description": "이름" },
            "role":  { "type": "string", "description": "직함 또는 회사" }
          }
        }
      },
      "contact_heading": { "type": "string", "description": "6번 카드 헤드라인" },
      "contact_body":    { "type": "string", "description": "6번 카드 본문" },
      "contact_label":   { "type": "string", "description": "CTA 버튼 텍스트" },
      "contact_items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 3,
        "description": "연락처 항목",
        "items": {
          "type": "object",
          "required": ["icon", "label", "value"],
          "properties": {
            "icon":  { "type": "string" },
            "label": { "type": "string" },
            "value": { "type": "string" }
          }
        }
      }
    }
  }
}
