{
  "id": "product",
  "mode": "skeleton",
  "label": "제품 소개",
  "description": "자동 목차·스크롤마커 제품 소개 페이지 (ContentsMarker)",
  "skeleton_file": "skeleton.html",
  "styles_file": "styles.css",
  "shared_cm_file": "contents-marker-base.css",
  "palette": {
    "background": "#ffffff",
    "surface": "#f8fafc",
    "surface_alt": "#f0fdfa",
    "text_primary": "#0f172a",
    "text_secondary": "#475569",
    "divider": "#e2e8f0",
    "accent": "#0d9488",
    "accent_dark": "#0f766e"
  },
  "content_schema": {
    "type": "object",
    "required": ["product", "stats", "overview_heading", "overview", "features_heading", "features", "specs_heading", "spec_groups", "use_cases_heading", "use_cases", "pricing_heading", "plans", "cta_heading", "cta_body", "cta_label"],
    "properties": {
      "product": {
        "type": "object",
        "required": ["name", "tagline", "category"],
        "description": "제품 기본 정보",
        "properties": {
          "name":     { "type": "string", "description": "제품 이름" },
          "tagline":  { "type": "string", "description": "한 줄 핵심 가치 (짧고 임팩트 있게)" },
          "category": { "type": "string", "description": "제품 카테고리 (예: SaaS, 하드웨어, 앱)" },
          "version":  { "type": "string", "description": "버전 또는 출시일 (선택)" }
        }
      },
      "stats": {
        "type": "array",
        "minItems": 3,
        "maxItems": 4,
        "description": "핵심 수치 지표 3~4개",
        "items": {
          "type": "object",
          "required": ["value", "label"],
          "properties": {
            "value": { "type": "string", "description": "수치 (예: 99.9%, 2초, 1만+)" },
            "label": { "type": "string", "description": "지표 이름 (예: 가동률, 처리 속도)" },
            "unit":  { "type": "string", "description": "단위 보조 설명 (선택)" }
          }
        }
      },
      "overview_heading": { "type": "string", "description": "개요 섹션 제목" },
      "overview": {
        "type": "array",
        "minItems": 2,
        "maxItems": 3,
        "description": "제품 개요 단락 2~3개",
        "items": { "type": "string" }
      },
      "features_heading": { "type": "string", "description": "핵심 기능 섹션 제목" },
      "features": {
        "type": "array",
        "minItems": 4,
        "maxItems": 6,
        "description": "주요 기능 목록",
        "items": {
          "type": "object",
          "required": ["id", "icon", "title", "desc"],
          "properties": {
            "id":        { "type": "string", "description": "영문 소문자 하이픈 ID" },
            "icon":      { "type": "string", "description": "이모지 아이콘 (1자)" },
            "title":     { "type": "string", "description": "기능 제목" },
            "desc":      { "type": "string", "description": "기능 설명 2~3문장" },
            "highlight": { "type": "string", "description": "강조 태그 (선택, 예: NEW, 독점)" }
          }
        }
      },
      "specs_heading": { "type": "string", "description": "사양 섹션 제목" },
      "spec_groups": {
        "type": "array",
        "minItems": 2,
        "maxItems": 4,
        "description": "사양 그룹 목록",
        "items": {
          "type": "object",
          "required": ["group", "items"],
          "properties": {
            "group": { "type": "string", "description": "사양 그룹 이름" },
            "items": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "object",
                "required": ["label", "value"],
                "properties": {
                  "label": { "type": "string" },
                  "value": { "type": "string" }
                }
              }
            }
          }
        }
      },
      "use_cases_heading": { "type": "string", "description": "활용 사례 섹션 제목" },
      "use_cases": {
        "type": "array",
        "minItems": 3,
        "maxItems": 4,
        "description": "활용 사례 목록",
        "items": {
          "type": "object",
          "required": ["id", "title", "scenario", "outcome"],
          "properties": {
            "id":       { "type": "string", "description": "영문 소문자 하이픈 ID" },
            "title":    { "type": "string", "description": "사례 제목 (대상 또는 상황)" },
            "scenario": { "type": "string", "description": "문제/상황 설명" },
            "outcome":  { "type": "string", "description": "도입 후 성과/결과" }
          }
        }
      },
      "pricing_heading": { "type": "string", "description": "가격 섹션 제목" },
      "plans": {
        "type": "array",
        "minItems": 2,
        "maxItems": 3,
        "description": "요금 플랜 2~3개",
        "items": {
          "type": "object",
          "required": ["name", "price", "period", "features"],
          "properties": {
            "name":     { "type": "string", "description": "플랜 이름" },
            "price":    { "type": "string", "description": "가격 (예: ₩29,000, 무료)" },
            "period":   { "type": "string", "description": "과금 단위 (예: /월, /년)" },
            "featured": { "type": "boolean", "description": "추천 플랜 여부" },
            "features": { "type": "array", "items": { "type": "string" }, "minItems": 3, "description": "포함 기능 목록" }
          }
        }
      },
      "cta_heading": { "type": "string", "description": "마지막 CTA 제목" },
      "cta_body":    { "type": "string", "description": "마지막 CTA 본문" },
      "cta_label":   { "type": "string", "description": "마지막 CTA 버튼 텍스트" }
    }
  }
}
